{
  "name": "dsh-trace-narrator",
  "description": "DSH 插件：把会话轨迹变成可分享、可复盘、可教学的结构化报告（脱敏 + LLM 总结，HTML/MD/JSON 输出）",
  "version": "1.2.2",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "trajectory",
    "llm",
    "conversation",
    "postmortem",
    "redaction"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiangyun0519/dsh-trace-narrator.git"
  },
  "homepage": "https://github.com/xiangyun0519/dsh-trace-narrator#readme",
  "bugs": {
    "url": "https://github.com/xiangyun0519/dsh-trace-narrator/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "package:check": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
